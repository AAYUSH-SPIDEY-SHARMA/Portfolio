# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── Chatbot (required for /api/chat) ──
# https://console.groq.com/keys
GROQ_API_KEY_1=

# ── API access control (optional) ──
# Extra origin allowed to call /api/chat, e.g. https://your-domain.com
ALLOWED_ORIGIN=

# ── Cloudinary (only needed to re-run scripts/ image uploads) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
