# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ══ Supabase (blog + wall + admin login) ══
# Project Settings → API. Use the publishable key (sb_publishable_...); the
# older JWT-style anon key also works but is being phased out. Either one is
# public by design — Row Level Security in supabase/schema.sql is what actually
# protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ══ Chatbot (/api/chat) ══
# https://console.groq.com/keys
GROQ_API_KEY_1=

# ══ Cloudinary (image uploads via /api/upload) ══
# Server-side only — these must NOT be prefixed with VITE_, or they would be
# bundled into the browser build and exposed to everyone.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ══ API access control (optional) ══
# Extra origin allowed to call /api/*, e.g. https://your-domain.com
ALLOWED_ORIGIN=
